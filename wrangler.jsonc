// Cloudflare-Konfiguration für das Wien / NÖ Dojo (Worker "dojo")
{
  "name": "dojo",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Diese Pfade gehen zuerst durch den Worker (API + geschützte Admin-Seite)
    "run_worker_first": ["/api/*", "/admin*", "/nihongo*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dojo-db",
      // D1-Datenbank dojo-db (Westeuropa), angelegt am 10.11.2026
      "database_id": "7b4a1f3e-b777-4e58-b95d-e98ce9e10ce0"
    }
  ],
  // admin.html wird als Text direkt in den Worker eingebaut
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "observability": { "enabled": true }
}
